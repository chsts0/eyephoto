{
  "name": "eyephoto",
  "productName": "EyePhoto",
  "version": "0.2.0",
  "description": "Редактор снимков радужки для студии",
  "main": "src/main.js",
  "author": "EyePhoto",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "libraw-wasm": "^1.6.0",
    "onnxruntime-node": "^1.31.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ru.eyephoto.app",
    "productName": "EyePhoto",
    "files": [
      "src/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/libraw-wasm/dist/*.map"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "EyePhoto",
      "artifactName": "EyePhoto-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "chsts0",
      "repo": "eyephoto",
      "releaseType": "release"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ]
  }
}
