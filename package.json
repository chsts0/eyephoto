{
  "name": "eyephoto",
  "productName": "EyePhoto",
  "version": "0.12.1",
  "description": "Редактор снимков радужки для студии",
  "main": "src/main.js",
  "author": "EyePhoto",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "ag-psd": "^34.2.0",
    "electron-updater": "^6.8.11",
    "libraw-wasm": "^1.6.0",
    "onnxruntime-node": "^1.31.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ru.eyephoto.app",
    "productName": "EyePhoto",
    "files": [
      "src/**/*",
      "!node_modules/libraw-wasm/dist/*.map",
      "!node_modules/ag-psd/dist/**/*.map"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "EyePhoto",
      "artifactName": "EyePhoto-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "chsts0",
      "repo": "eyephoto",
      "releaseType": "release"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "category": "public.app-category.photography",
      "artifactName": "EyePhoto-${version}-mac.${ext}",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "EyePhoto-${version}-mac.${ext}"
    },
    "extraResources": [
      {
        "from": "vendor/llama",
        "to": "llama"
      },
      {
        "from": "templates",
        "to": "templates",
        "filter": [
          "*.psd"
        ]
      }
    ],
    "afterPack": "build-scripts/after-pack.js"
  }
}
